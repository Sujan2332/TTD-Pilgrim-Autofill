{
  "manifest_version": 3,
  "name": "TTD Pilgrim Autofill",
  "version": "1.1.0",
  "description": "Manage multiple TTD pilgrim groups, import or export JSON, select pilgrims, and autofill booking details instantly.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://ttdevasthanams.ap.gov.in/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TTD Pilgrim Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "autofill-selected": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Autofill selected TTD pilgrims"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://ttdevasthanams.ap.gov.in/*"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://ttdevasthanams.ap.gov.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://ttdevasthanams.ap.gov.in/*"]
    }
  ]
}
